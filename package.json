{
  "name": "system1-visualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Procedural WebGL2 music visualizer for Spotify, directed by a TypeSafe System One model (Jev).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "dev": "node build.mjs --watch --serve",
    "standalone": "node build.mjs && node scripts/serve.mjs",
    "causality": "node scripts/run-causality.mjs",
    "analyze:logs": "node scripts/analyze-ab.mjs",
    "lyrics:causality": "node scripts/run-lyrics-causality.mjs",
    "perception:causality": "node scripts/run-perception-causality.mjs",
    "motion:causality": "node scripts/run-motion-causality.mjs",
    "build:causality": "node build.mjs",
    "substrate:server": "python tools/image-substrate-server.py",
    "perception:server": "python tools/audio-perception-server.py",
    "app": "node build.mjs && electron electron/main.cjs",
    "install-ext": "node build.mjs && node scripts/install.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "electron": "^44.4.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
